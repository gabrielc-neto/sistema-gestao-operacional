{
  "name": "05 - Price Monitor (baixa de preço)",
  "nodes": [
    {
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      },
      "id": "trigger",
      "name": "A cada 5min",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.1,
      "position": [240, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT DISTINCT ON (item_id) item_id, fonte, titulo, link_original, preco FROM ofertas_coletadas WHERE fonte IN ('mercadolivre','shopee','aliexpress') ORDER BY item_id, coletado_em DESC LIMIT 100"
      },
      "id": "pg-get-watched",
      "name": "Produtos monitorados",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [460, 400]
    },
    {
      "parameters": {
        "jsCode": "// Compara preço atual com histórico últimos 30 dias\n// Considera oferta VÁLIDA se: preço atual < média30d * 0.85 (>= 15% desconto real)\n\nconst item = $input.item.json;\n\n// Retorna instrução pra próximo node fazer query de comparação\nreturn {\n  json: {\n    ...item,\n    query_compare: `SELECT AVG(preco) as media_30d, MIN(preco) as min_30d FROM ofertas_coletadas WHERE item_id = '${item.item_id}' AND coletado_em > NOW() - INTERVAL '30 days'`\n  }\n};"
      },
      "id": "prep-compare",
      "name": "Prepara comparação",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [680, 400]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "={{ $json.query_compare }}"
      },
      "id": "pg-avg",
      "name": "Busca média 30d",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [900, 400]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict" },
          "conditions": [
            {
              "id": "1",
              "leftValue": "={{ $('Prepara comparação').item.json.preco }}",
              "rightValue": "={{ $json.media_30d * 0.85 }}",
              "operator": { "type": "number", "operation": "lt" }
            }
          ],
          "combinator": "and"
        }
      },
      "id": "if-desconto-real",
      "name": "É desconto real >15%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1120, 400]
    },
    {
      "parameters": {
        "operation": "insert",
        "table": "ofertas_validadas_ia",
        "columns": "item_id,fonte,titulo,preco,media_30d,desconto_real_pct,link_original,detectado_em",
        "additionalFields": {}
      },
      "id": "pg-validated",
      "name": "Marca como oferta boa",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [1340, 300]
    }
  ],
  "connections": {
    "A cada 1h": { "main": [[{ "node": "Produtos monitorados", "type": "main", "index": 0 }]] },
    "Produtos monitorados": { "main": [[{ "node": "Prepara comparação", "type": "main", "index": 0 }]] },
    "Prepara comparação": { "main": [[{ "node": "Busca média 30d", "type": "main", "index": 0 }]] },
    "Busca média 30d": { "main": [[{ "node": "É desconto real >15%?", "type": "main", "index": 0 }]] },
    "É desconto real >15%?": { "main": [[{ "node": "Marca como oferta boa", "type": "main", "index": 0 }], []] }
  },
  "active": false,
  "settings": { "executionOrder": "v1" }
}

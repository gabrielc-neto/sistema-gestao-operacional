# =====================================================
# COPIE ESTE ARQUIVO COMO .env E PREENCHA
# NUNCA COMMITE .env NO GIT
# =====================================================

# --- POSTGRES (deixe assim se rodar local) ---
POSTGRES_USER=n8n
POSTGRES_PASSWORD=TROQUE_ESSA_SENHA_FORTE
POSTGRES_DB=n8n

# --- N8N SEGURANÇA (gere strings aleatórias de 32+ caracteres) ---
# Windows PowerShell: [Guid]::NewGuid().ToString() + [Guid]::NewGuid().ToString()
# Linux/Mac: openssl rand -hex 32
N8N_ENCRYPTION_KEY=troque_por_string_aleatoria_32_chars_ou_mais
N8N_JWT_SECRET=outra_string_aleatoria_32_chars_ou_mais

# --- N8N URL (deixe assim pra local; mude quando for pra Oracle Cloud) ---
N8N_HOST=localhost
WEBHOOK_URL=http://localhost:5678/

# --- IA (obrigatórias) ---
GEMINI_API_KEY=AIzaSy...
GROQ_API_KEY=gsk_...

# --- TELEGRAM (obrigatórias) ---
TELEGRAM_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxx
TELEGRAM_CHANNEL_ID=@ofertaswesley

# --- AMAZON (obrigatórias pra Amazon PA-API funcionar) ---
AMAZON_PARTNER_TAG=seunome-20
AMAZON_ACCESS_KEY=AKIA...
AMAZON_SECRET_KEY=...

# --- MERCADO LIVRE ---
ML_CLIENT_ID=1234567890
ML_CLIENT_SECRET=...
ML_AFFILIATE_ID=SEU-ID

# --- SHOPEE ---
SHOPEE_AFFILIATE_ID=seu-id
SHOPEE_APP_ID=...
SHOPEE_APP_SECRET=...

# --- ALIEXPRESS ---
ALIEXPRESS_PID=9d5f9d5f9d5f9d5f
ALIEXPRESS_APP_KEY=...
ALIEXPRESS_APP_SECRET=...

# --- EVOLUTION API (WhatsApp) ---
EVOLUTION_API_KEY=troque_esta_chave_ficando_forte_123

# =====================================================
# EXTRAS (opcionais — adicionar semana 2+)
# Ver: 01-cadastros/06-agregadores-extras.md
# =====================================================

# --- MÉLIUZ (cashback + afiliado 2x) ---
MELIUZ_CLIENT_ID=
MELIUZ_CLIENT_SECRET=
MELIUZ_REFERRAL_CODE=SEUCODIGO

# --- REDDIT ---
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER=
REDDIT_PASSWORD=

# --- KEEPA (Amazon histórico, 100 free/dia) ---
KEEPA_API_KEY=

# --- ZOOM API (opcional, se scraping cair) ---
ZOOM_API_KEY=

# --- KUTT (encurtador + feedback loop CTR) ---
# Ver 01-cadastros/07-kutt-encurtador.md pra setup completo
KUTT_ADMIN_EMAIL=seu-email@dominio.com
KUTT_JWT_SECRET=string_aleatoria_32_caracteres_troque_isso
KUTT_API_KEY=preencha_depois_de_criar_conta_no_localhost_3010
KUTT_DOMAIN=localhost:3010
